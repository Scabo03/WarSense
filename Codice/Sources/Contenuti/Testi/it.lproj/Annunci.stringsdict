      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>Giornata chiusa. %d gruppo non aveva agito e resta fermo: ne è stata conservata una traccia accanto al salvataggio.</string>
