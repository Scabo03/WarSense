<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>battaglia.atomi_presenti</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@atomi@</string>
    <key>atomi</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d atomo</string>
      <key>other</key><string>%d atomi</string>
    </dict>
  </dict>
  <key>battaglia.stato_ritirata</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>, %#@righe@ alla soglia della ritirata</string>
    <key>righe</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d riga</string>
      <key>other</key><string>%d righe</string>
    </dict>
  </dict>
  <key>resoconto.durata</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>Durata: %#@turni@</string>
    <key>turni</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d turno</string>
      <key>other</key><string>%d turni</string>
    </dict>
  </dict>
  <key>deck.esemplari</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@esemplari@</string>
    <key>esemplari</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d esemplare</string>
      <key>other</key><string>%d esemplari</string>
    </dict>
  </dict>
  <key>gruppo.in_marcia</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>in marcia, %#@giorni@</string>
    <key>giorni</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d giorno al termine</string>
      <key>other</key><string>%d giorni al termine</string>
    </dict>
  </dict>
  <key>casella.disponibile</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>raggiungibile in %#@giorni@</string>
    <key>giorni</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%d giorno di marcia</string>
      <key>other</key><string>%d giorni di marcia</string>
    </dict>
  </dict>
  <key>campagna.marcia_ordinata</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>%4$#@giorni@</string>
    <key>giorni</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%1$@ marcia verso riga %2$d, casella %3$d, %4$d giorno al termine</string>
      <key>other</key><string>%1$@ marcia verso riga %2$d, casella %3$d, %4$d giorni al termine</string>
    </dict>
  </dict>
  <key>campagna.marcia_revocata</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>%2$#@giorni@</string>
    <key>giorni</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>%1$@: marcia revocata, perso %2$d giorno</string>
      <key>other</key><string>%1$@: marcia revocata, persi %2$d giorni</string>
    </dict>
  </dict>
  <key>pannello.revoca_conferma</key>
  <dict>
    <key>NSStringLocalizedFormatKey</key><string>%2$#@giorni@</string>
    <key>giorni</key>
    <dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>d</string>
      <key>one</key><string>Revoca la marcia di %1$@. Perdi %2$d giorno e il gruppo resta senza azione oggi.</string>
      <key>other</key><string>Revoca la marcia di %1$@. Perdi %2$d giorni e il gruppo resta senza azione oggi.</string>
    </dict>
  </dict>
</dict></plist>
